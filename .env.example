# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production
API_KEY=your-api-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM APIs (비용 무제한)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_MESSAGE_LENGTH=8000
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2

# External APIs
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key-here

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Resource Limits
MAX_UPLOAD_SIZE_MB=500
MAX_CONCURRENT_TASKS=5
FLAML_DEFAULT_TIME_BUDGET=3600

# Logging
LOG_LEVEL=INFO
